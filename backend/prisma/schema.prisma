// Prisma Schema — Client Project Dashboard
// All models, enums, indexes, and relations per spec

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  PM
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGE
  TASK_OVERDUE
  TASK_IN_REVIEW
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  // Relations
  createdProjects Project[]         @relation("ProjectCreator")
  assignedTasks   Task[]            @relation("TaskAssignee")
  activityLogs    TaskActivityLog[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
}

model Client {
  id           String   @id @default(uuid())
  name         String
  contactEmail String
  createdAt    DateTime @default(now())

  // Relations
  projects Project[]
}

model Project {
  id          String   @id @default(uuid())
  name        String
  clientId    String
  createdById String
  createdAt   DateTime @default(now())

  // Relations
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("ProjectCreator", fields: [createdById], references: [id])
  tasks        Task[]
  activityLogs TaskActivityLog[]

  @@index([clientId])
  @@index([createdById])
}

model Task {
  id                  String       @id @default(uuid())
  projectId           String
  title               String
  description         String?
  assignedDeveloperId  String
  status              TaskStatus   @default(TODO)
  priority            TaskPriority @default(MEDIUM)
  dueDate             DateTime?
  isOverdue           Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relations
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedDeveloper User              @relation("TaskAssignee", fields: [assignedDeveloperId], references: [id])
  activityLogs      TaskActivityLog[]
  notifications     Notification[]

  @@index([projectId])
  @@index([assignedDeveloperId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isOverdue])
}

model TaskActivityLog {
  id         String      @id @default(uuid())
  taskId     String
  projectId  String      // Denormalized for efficient project-scoped queries
  userId     String?     // Null for system-generated entries (e.g., overdue scanner)
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  message    String
  createdAt  DateTime    @default(now())

  // Relations
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt(sort: Desc)])
  @@index([taskId])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  type          NotificationType
  message       String
  relatedTaskId String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  // Relations
  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedTask Task? @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}
